{
  "name": "near-me-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/domain.test.ts",
    "test:db": "node --experimental-strip-types scripts/test-migrations.ts",
    "migrate": "node --experimental-strip-types scripts/migrate.ts",
    "test:integration": "node --experimental-strip-types --import ./test/harness/register.mjs --test --test-concurrency=1 test/integration*.test.ts",
    "test:all": "npm test && npm run test:db && npm run test:integration"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.0.0",
    "next": "15.5.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "@types/react": "19.1.0",
    "typescript": "5.7.3"
  }
}