# Copy to .env.local (dev) or set in Vercel Project Settings > Environment Variables. NEVER commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
JWT_SECRET=            # >= 32 random bytes, e.g. `openssl rand -base64 48`
DATA_ENCRYPTION_KEY=   # 32 bytes base64, `openssl rand -base64 32`
OWNER_BOOTSTRAP_TOKEN= # one-time token used by scripts/bootstrap-owner.ts, remove afterwards
FCM_SERVICE_ACCOUNT_JSON=      # awaiting Owner credentials
OBJECT_STORAGE_ENDPOINT=       # S3-compatible (Cloudflare R2 / AWS S3) - awaiting Owner credentials
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_KEY_ID=
OBJECT_STORAGE_SECRET=
REALTIME_PROVIDER=ably         # ably | pusher | none  - awaiting Owner credentials
REALTIME_API_KEY=
EMAIL_PROVIDER=resend          # resend | postmark | none
EMAIL_API_KEY=
AI_PROVIDER=none               # none | anthropic | openai
AI_API_KEY=
MALWARE_SCAN_PROVIDER=none     # none | virustotal | clamav-http
MALWARE_SCAN_API_KEY=
CRON_SECRET=          # random string; Vercel sends it as Authorization: Bearer for cron jobs
APP_PUBLIC_URL=       # https://your-app.vercel.app (used in email links)
GOOGLE_CLIENT_ID=      # Google OAuth *Web* client ID (used to verify ID tokens) - awaiting Owner credentials

GIPHY_API_KEY=none      # GIF search (GIPHY). 501 until set
FACEBOOK_CLIENT_ID=none  # Marketing Center OAuth (Facebook+Instagram)
FACEBOOK_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=none
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=none
X_CLIENT_SECRET=
